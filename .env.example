# 文件说明: AI LoveMoney 公开站环境变量模板。复制为 .env.development、.env.staging 或 .env.production 后填写真实值。

# ===== Database =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=ailovemoney

# ===== Public Web =====
PORT=3101
PUBLIC_SITE_URL=https://ai.lovemoney.live
HEADER_AD_TAG_ENABLED=

# ===== Local anonymous measurement (disabled by default) =====
MEASUREMENT_ENABLED=false
MEASUREMENT_ENVIRONMENT=local-test
MEASUREMENT_RETENTION_DAYS=14
MEASUREMENT_MAX_EVENT_BYTES=2048
MEASUREMENT_MAX_EVENTS_PER_DAY=10000

# ===== Reputation Data =====
ABUSEIPDB_API_KEY=
GREYNOISE_API_KEY=
