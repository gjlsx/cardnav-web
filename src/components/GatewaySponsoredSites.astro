---
/*
文件说明: 渲染中转站独立赞助展示区，与自然榜分开，仅使用文字标签标明合作关系。
*/
import { formatPositiveScore } from '../gateway-display.js';
import SponsorBadge from './SponsorBadge.astro';

type SponsoredSite = {
  name: string;
  slug: string;
  url?: string;
  host?: string;
  summary?: string;
  siteScore?: number | null;
  displayModelFamilies?: string[];
};

type DataAttrs = Record<string, string | number | boolean | undefined>;

type Props = {
  sites: SponsoredSite[];
  title: string;
  description: string;
  sponsorLabel: string;
  sponsorDescription: string;
  sponsorHref: string;
  sponsorLinkLabel: string;
  detailLabel: string;
  detailHref: (slug: string) => string;
  scoreLabel: string;
  clickAttrs?: (site: SponsoredSite) => DataAttrs;
};

const {
  sites,
  title,
  description,
  sponsorLabel,
  sponsorDescription,
  sponsorHref,
  sponsorLinkLabel,
  detailLabel,
  detailHref,
  scoreLabel,
  clickAttrs = () => ({}),
} = Astro.props;
---

{sites.length > 0 ? (
  <section class="border-b border-base-300 bg-base-200/50 px-4 py-4" data-gateway-sponsored aria-labelledby="gateway-sponsored-title">
    <h2 id="gateway-sponsored-title" class="text-base font-semibold text-base-content">{title}</h2>
    <p class="mt-1 max-w-3xl text-sm leading-6 text-base-content/75">{description}</p>
    <ul class="mt-3 grid gap-3 md:grid-cols-2" data-gateway-sponsored-list>
      {sites.map(site => (
        <li
          class="rounded-xl border border-base-300 bg-base-100 p-4"
          data-gateway-sponsored-item
          data-search={`${site.name} ${site.url || ''} ${site.host || ''} ${(site.displayModelFamilies || []).join(' ')}`.toLowerCase()}
          data-families={(site.displayModelFamilies || []).map(item => item.toLowerCase()).join(',')}
        >
          <div class="flex flex-wrap items-center gap-2">
            <a href={detailHref(site.slug)} class="link link-hover text-base font-semibold text-primary" {...clickAttrs(site)}>{site.name}</a>
            <SponsorBadge label={sponsorLabel} description={sponsorDescription} href={sponsorHref} linkLabel={sponsorLinkLabel} />
          </div>
          {site.summary ? <p class="mt-2 text-sm leading-6 text-base-content/72">{site.summary}</p> : null}
          <div class="mt-3 flex flex-wrap items-center gap-3 text-xs text-base-content/60">
            <span>{scoreLabel}: <span class="font-mono text-sm text-base-content">{formatPositiveScore(site.siteScore ?? null)}</span></span>
            <a href={detailHref(site.slug)} class="btn btn-primary btn-xs h-7 min-h-7 px-3" {...clickAttrs(site)}>{detailLabel}</a>
          </div>
        </li>
      ))}
    </ul>
  </section>
) : null}
