---
/*
文件说明: 渲染模型排行榜页的服务端 HTML 内容，包括任务导航和当前任务榜单。
*/
import PageHero from './PageHero.astro';
import DataTable from './DataTable.astro';
import DataTableCell from './DataTableCell.astro';
import DataTableHeader from './DataTableHeader.astro';
import type { LocalizedModelLeaderboardGroup } from '../localized-display.js';
import { leaderboardRelatedPaths } from '../model-leaderboard.js';
import { formatBeijingRefreshTime } from '../store.js';

type Props = {
  groups: LocalizedModelLeaderboardGroup[];
  currentGroup: LocalizedModelLeaderboardGroup | null;
  currentGroupTotalCount?: number;
  updateTime: string;
};

const { groups, currentGroup, currentGroupTotalCount = currentGroup?.rows.length ?? 0, updateTime } = Astro.props;
const t = Astro.locals.messages;
const linkTo = Astro.locals.localizePath;
const initialRowCount = 30;
const visibleRows = currentGroup?.rows.slice(0, initialRowCount) ?? [];
const hasMoreRows = currentGroupTotalCount > visibleRows.length;
const emptyText = currentGroup && currentGroup.rows.length === 0 ? t.leaderboard.emptySample : t.leaderboard.empty;
const leaderboardApiUrl = currentGroup
  ? `/api/model-leaderboard/${encodeURIComponent(currentGroup.taskSlug)}.json?offset=${initialRowCount}&locale=${encodeURIComponent(Astro.locals.locale)}`
  : '';

function relatedLinks(modelFamily: string) {
  const paths = leaderboardRelatedPaths(modelFamily);
  return {
    shopPath: paths.shopPath ? linkTo(paths.shopPath) : '',
    gatewayPath: paths.gatewayPath ? linkTo(paths.gatewayPath) : '',
  };
}
---

<PageHero
  title={currentGroup ? `${currentGroup.displayName}${t.leaderboard.titleSuffix}` : t.leaderboard.title}
  description={t.leaderboard.description}
>
  <p slot="note" class="page-hero-note">{t.leaderboard.note}</p>
  <p slot="meta" class="page-hero-meta">
    <span>{t.labels.latestRefreshBeijing}：{updateTime}</span>
  </p>
</PageHero>

{(groups.length > 0 || currentGroup) && (
  <section
    class="card bg-base-100 border border-base-300 shadow-sm overflow-hidden"
    data-model-leaderboard={currentGroup ? '' : undefined}
    data-model-leaderboard-api={currentGroup ? leaderboardApiUrl : undefined}
    data-model-leaderboard-total={currentGroupTotalCount}
  >
    {groups.length > 0 && (
      <div class="border-b border-base-300 bg-base-100 px-4 py-3">
        <nav class="tool-tablist-wrap" aria-label={t.leaderboard.taskNavLabel}>
          <div class="tabs tabs-box content-tablist" role="tablist">
            {groups.map(group => {
              const isCurrent = currentGroup?.taskSlug === group.taskSlug;
              return (
                <a
                  role="tab"
                  href={linkTo(group.pathname)}
                  class={`tab content-tab ${isCurrent ? 'tab-active' : ''}`}
                  aria-selected={isCurrent ? 'true' : 'false'}
                  aria-current={isCurrent ? 'page' : undefined}
                >
                  {group.displayName}
                </a>
              );
            })}
          </div>
        </nav>
      </div>
    )}
    {currentGroup && (
      <>
        <DataTable
          sortable={false}
          variant="compact"
          emptyText={emptyText}
          emptyHidden={currentGroup.rows.length > 0}
          emptyDataAttrs={{ 'data-model-leaderboard-empty': '' }}
          summaryText={currentGroupTotalCount > 0 ? t.labels.displaySummary : ''}
          summaryRenderedCount={visibleRows.length}
          totalCount={currentGroupTotalCount}
          summaryDataAttrs={{ 'data-model-leaderboard-load-summary': '', 'data-summary-template': t.labels.displaySummary }}
          loadMoreText={hasMoreRows ? t.labels.loadMore : ''}
          loadMoreHidden={!hasMoreRows}
          loadMoreDataAttrs={{ 'data-model-leaderboard-load-more': '' }}
          tbodyDataAttrs={{ 'data-model-leaderboard-body': '' }}
        >
          <Fragment slot="head">
            <DataTableHeader label={t.labels.sequence} sortKey="sequence" sortType="number" align="center" />
            <DataTableHeader label={t.labels.model} sortable={false} />
            <DataTableHeader label={t.leaderboard.referenceScore} sortable={false} />
          </Fragment>
          {visibleRows.map(item => {
            const related = relatedLinks(item.modelFamily);
            const evidence = item.evidence;
            const sampledAt = evidence.sampledAt ? formatBeijingRefreshTime(evidence.sampledAt) : '';
            return (
            <tr data-sort-sequence={evidence.displayRank === null ? '' : String(evidence.displayRank)} data-leaderboard-evidence-group={evidence.groupKey}>
              <DataTableCell label={t.labels.sequence} align="center" sequence>{evidence.displayRank ?? t.leaderboard.notProvided}</DataTableCell>
              <DataTableCell label={t.labels.model} class="text-base-content">
                <div class="flex min-w-0 flex-col gap-1">
                  <div class="flex flex-wrap items-center gap-2">
                    <span class="font-semibold break-all">{item.modelName}</span>
                    {evidence.status === 'sample' && <span class="badge badge-ghost badge-sm">{t.leaderboard.sampleBadge}</span>}
                  </div>
                  <div class="flex flex-wrap items-center gap-x-2 text-xs leading-5 text-base-content/60" data-leaderboard-evidence>
                    <span>{t.leaderboard.sourceLabel}：{item.localizedSourceName || t.leaderboard.notProvided}</span>
                    {evidence.sourceUrl && <a href={evidence.sourceUrl} target="_blank" rel="noreferrer" class="link link-hover" data-umami-event="leaderboard-source-click" data-umami-event-url={evidence.sourceUrl} data-measurement-name="evidence_open" data-measurement-page-kind="leaderboard" data-measurement-entity-id={item.modelFamily} data-measurement-source-id={item.sourceId}>{t.leaderboard.sourceLink}</a>}
                    {sampledAt && <span>{t.leaderboard.sampledAt}：{sampledAt}</span>}
                    <span>{t.leaderboard.sourceBoard}：{item.sourceBoardSlug || t.leaderboard.notProvided}</span>
                    <span>{t.leaderboard[evidence.status]}</span>
                    {evidence.methodStatus === 'not-recorded' && <span>{t.leaderboard.methodNotRecorded}</span>}
                  </div>
                  <div class="flex flex-row flex-wrap items-center gap-2">
                    {related.shopPath && (
                      <a
                        href={related.shopPath}
                        class="inline-flex w-fit items-center gap-1 rounded-md bg-info/10 px-2 py-1 text-xs leading-5 text-info-content hover:bg-info/15"
                        data-umami-event="leaderboard-shop-tip-click"
                        data-umami-event-url={related.shopPath}
                        data-umami-event-name={item.modelFamily}
                      >
                        <span>{t.leaderboard.shopProductsTip}</span>
                      </a>
                    )}
                    {related.gatewayPath && (
                      <a
                        href={related.gatewayPath}
                        class="inline-flex w-fit items-center gap-1 rounded-md bg-info/10 px-2 py-1 text-xs leading-5 text-info-content hover:bg-info/15"
                        data-umami-event="leaderboard-gateway-tip-click"
                        data-umami-event-url={related.gatewayPath}
                        data-umami-event-name={item.modelFamily}
                      >
                        <span>{t.leaderboard.gatewayTip}</span>
                      </a>
                    )}
                    {!related.shopPath && !related.gatewayPath && (
                      <span class="text-xs leading-5 text-base-content/55">{t.leaderboard.relatedEmpty}</span>
                    )}
                  </div>
                </div>
              </DataTableCell>
              <DataTableCell label={t.leaderboard.referenceScore} class="font-mono font-bold text-primary">{evidence.displayScore === null ? t.leaderboard.notProvided : evidence.displayScore.toFixed(2)}</DataTableCell>
            </tr>
            );
          })}
        </DataTable>
      </>
    )}
  </section>
)}

{groups.length === 0 && (
  <section class="alert alert-info alert-soft max-w-md mx-auto my-6 justify-center">
    <span>{t.leaderboard.empty}</span>
  </section>
)}
