---
/*
文件说明: 渲染 AI 大模型 API 中转站入口页，通过中转站和模型两个标签页展示排行并支持本地加载更多。
*/
import PageHero from '../components/PageHero.astro';
import PublicPage from '../layouts/PublicPage.astro';
import GatewaySiteTableRow from '../components/GatewaySiteTableRow.astro';
import GatewaySponsoredSites from '../components/GatewaySponsoredSites.astro';
import DataTable from '../components/DataTable.astro';
import DataTableCell from '../components/DataTableCell.astro';
import DataTableHeader from '../components/DataTableHeader.astro';
import { collectFilterOptions, uniqueLabels } from '../gateway-display.js';
import { splitGatewaySiteRanking } from '../gateway-ranking.js';
import { buildSeoContext } from '../seo.js';
import { gatewaySubmissionEmail, publicSiteUrl, telegramGroupUrl } from '../site.js';
import { loadGatewayModels, loadGatewaySites } from '../store.js';
import dataTableScriptUrl from '../scripts/data-table.js?url';
import pageWidgetsScriptUrl from '../scripts/page-widgets.js?url';
import sponsorBadgeScriptUrl from '../scripts/sponsor-badge.js?url';

const t = Astro.locals.messages;
const linkTo = Astro.locals.localizePath;
const GATEWAY_SITE_PAGE_SIZE = 20;
const GATEWAY_MODEL_PAGE_SIZE = 100;
const requestedModelFamily = Astro.url.searchParams.get('model')?.trim().toLowerCase() || '';
const gatewayData = await loadGatewaySites({ modelFamily: requestedModelFamily });
const gatewayModelData = await loadGatewayModels({ limit: GATEWAY_MODEL_PAGE_SIZE });
const siteRanking = splitGatewaySiteRanking(gatewayData.sites);
const topSites = siteRanking.natural.slice(0, GATEWAY_SITE_PAGE_SIZE);
const sponsoredSites = siteRanking.sponsored;
const topModels = gatewayModelData.models;
const seo = buildSeoContext({
  baseUrl: publicSiteUrl,
  pathname: '/llm-gateway',
  title: t.llmGateway.seoTitle,
  description: t.llmGateway.seoDescription,
  imagePath: '/og-cardnav.webp',
  type: 'website',
  locale: Astro.locals.locale,
});


function modelHref(modelId: string) {
  return linkTo(`/llm-gateway/models/${encodeURIComponent(modelId)}`);
}

function gatewaySiteClickAttrs(site: { name: string; slug: string; outboundUrl: string }) {
  const targetPage = linkTo(`/llm-gateway/${site.slug}`);
  return {
    'data-umami-event': 'gateway-site-click',
    'data-umami-event-name': site.name,
    'data-umami-event-target-page': targetPage,
    'data-umami-event-url': targetPage,
  };
}

function gatewayModelClickAttrs(model: { modelId: string; modelFamily: string }) {
  const targetPage = modelHref(model.modelId);
  return {
    'data-umami-event': 'gateway-model-click',
    'data-umami-event-name': model.modelId,
    'data-umami-event-family': model.modelFamily,
    'data-umami-event-target-page': targetPage,
    'data-umami-event-url': targetPage,
  };
}

const modelFilterOptions = collectFilterOptions(gatewayData.sites.map(site => site.displayModelFamilies));
const hasMoreSites = gatewayData.totalSiteCount > topSites.length;
const hasMoreModels = gatewayModelData.totalModelCount > topModels.length;
const gatewayHomeConfig = {
  gatewayLinkPrefix: linkTo('/llm-gateway'),
  modelLinkPrefix: linkTo('/llm-gateway/models'),
  sitePageSize: GATEWAY_SITE_PAGE_SIZE,
  modelPageSize: GATEWAY_MODEL_PAGE_SIZE,
  siteTotalCount: gatewayData.totalSiteCount,
  modelTotalCount: gatewayModelData.totalModelCount,
  displaySummary: t.labels.displaySummary,
  sitesApi: `/api/llm-gateway/sites.json?offset=${GATEWAY_SITE_PAGE_SIZE}&locale=${encodeURIComponent(Astro.locals.locale)}${requestedModelFamily ? `&model=${encodeURIComponent(requestedModelFamily)}` : ''}`,
  modelsApi: `/api/llm-gateway/models.json?offset=${GATEWAY_MODEL_PAGE_SIZE}&locale=${encodeURIComponent(Astro.locals.locale)}`,
  detailLabel: t.llmGateway.viewDetail,
  sequenceLabel: t.labels.sequence,
  basicInfoLabel: t.llmGateway.basicInfo,
  sponsorLabel: t.sponsors.sponsorLabel,
  sponsorDescription: t.sponsors.sponsorDescription,
  partnershipUrl: linkTo('/partnership'),
  partnershipLinkLabel: t.sponsors.partnershipLinkLabel,
  scoreLabel: t.labels.score,
  supportedModelsLabel: t.llmGateway.supportedModels,
  latestRefreshLabel: t.labels.latestRefresh,
  modelLabel: t.labels.model,
  modelFamilyLabel: t.llmGateway.modelFamily,
  supportedGatewayCountLabel: t.llmGateway.supportedGatewayCount,
  referenceSampleLabel: t.shops.referenceSample,
  sampledAtLabel: t.llmGateway.sampledAt,
  sourceLabel: t.shops.sourcePrefix,
};
const gatewaySubmissionChecklist: string[] = t.llmGateway.emailSubmissionChecklist;
const gatewayMailto = `mailto:${gatewaySubmissionEmail}?subject=${encodeURIComponent(t.llmGateway.emailSubmissionSubject)}&body=${encodeURIComponent(`${t.llmGateway.emailSubmissionBody}\n${gatewaySubmissionChecklist.map(item => `- ${item}`).join('\n')}`)}`;
---

<PublicPage activeNav="llm-gateway" {...seo}>
  <PageHero title={t.llmGateway.title} description={t.llmGateway.description}>
    <p slot="note" class="page-hero-note">
      {t.llmGateway.notePrefix}
      <a href={telegramGroupUrl} target="_blank" rel="noopener noreferrer" class="font-medium text-primary no-underline hover:text-[color:var(--color-primary-hover)] focus:outline-none focus-visible:rounded-sm focus-visible:ring-2 focus-visible:ring-primary/30" data-umami-event="gateway-report-click" data-umami-event-url={telegramGroupUrl} data-umami-event-name={t.llmGateway.reportIssue}>{t.llmGateway.reportIssue}</a>
      {t.llmGateway.noteSuffix}
    </p>
    <div slot="aside" class="flex flex-col items-stretch gap-3">
      <a href={linkTo('/ranking-reference?tab=transit')} class="btn btn-outline btn-md w-full">查看中转参考</a>
      <button id="openGatewaySubmitModal" type="button" class="btn btn-primary btn-md w-full" data-umami-event="gateway-submit-open-click" data-umami-event-name={t.llmGateway.submitGateway}>
        {t.llmGateway.submitGateway}
      </button>
      <div class="stats stats-vertical sm:stats-horizontal border border-base-300 bg-base-100 shadow-none">
        <div class="stat px-4 py-3">
          <div class="stat-title text-xs">{t.llmGateway.listedSites}</div>
          <div class="stat-value text-2xl text-primary">{gatewayData.totalSiteCount}</div>
        </div>
        <div class="stat px-4 py-3">
          <div class="stat-title text-xs">{t.llmGateway.sitesWithPrices}</div>
          <div class="stat-value text-2xl text-secondary">{gatewayData.sitesWithPricesCount}</div>
        </div>
        <div class="stat px-4 py-3">
          <div class="stat-title text-xs">{t.llmGateway.modelRecords}</div>
          <div class="stat-value text-2xl">{gatewayModelData.totalModelCount}</div>
        </div>
      </div>
    </div>
  </PageHero>

  {gatewayData.sites.length === 0 ? (
    <section class="alert alert-warning shadow-sm max-w-md mx-auto my-6 justify-center">
      <span>{t.llmGateway.empty}</span>
    </section>
  ) : (
    <section class="card bg-base-100 border border-base-300 shadow-sm overflow-hidden" data-gateway-home data-measurement-entry="gateway-list">
      <div class="border-b border-base-300 bg-base-100 px-4 py-3">
        <div class="tool-tablist-wrap">
          <div class="tabs tabs-box gateway-home-tablist" role="tablist" aria-label={t.llmGateway.title}>
            <button type="button" class="tab tab-active" role="tab" aria-selected="true" aria-controls="gatewaySitesPanel" id="gatewaySitesTab" data-gateway-tab="sites">
              {t.llmGateway.gatewayListTitle}
              <span class="tool-tab-badge">{gatewayData.totalSiteCount}</span>
            </button>
            <button type="button" class="tab" role="tab" aria-selected="false" aria-controls="gatewayModelsPanel" id="gatewayModelsTab" data-gateway-tab="models">
              {t.llmGateway.modelListTitle}
              <span class="tool-tab-badge">{gatewayModelData.totalModelCount}</span>
            </button>
          </div>
        </div>
      </div>

      <div id="gatewaySitesPanel" class="flex w-full min-w-0 flex-col gap-0" role="tabpanel" aria-labelledby="gatewaySitesTab" data-gateway-panel="sites">
          <div class="gateway-filter-grid grid gap-3 border-b border-base-300 p-4 md:grid-cols-[minmax(0,1fr)_180px]">
            <label class="input input-bordered flex h-11 items-center gap-2">
              <input data-home-site-search type="search" class="grow text-sm" placeholder={t.llmGateway.searchPlaceholder} />
            </label>
            <select data-home-site-family class="select select-bordered h-11 min-h-11 text-sm" aria-label={t.llmGateway.familyFilter}>
              <option value="">{t.llmGateway.allFamilies}</option>
              {modelFilterOptions.map(model => <option value={model.toLowerCase()}>{model}</option>)}
            </select>
          </div>
          <GatewaySponsoredSites
            sites={sponsoredSites}
            title={t.llmGateway.sponsoredSectionTitle}
            description={t.llmGateway.sponsoredSectionDescription}
            sponsorLabel={t.sponsors.sponsorLabel}
            sponsorDescription={t.sponsors.sponsorDescription}
            sponsorHref={linkTo('/partnership')}
            sponsorLinkLabel={t.sponsors.partnershipLinkLabel}
            detailLabel={t.llmGateway.viewDetail}
            detailHref={slug => linkTo(`/llm-gateway/${slug}`)}
            scoreLabel={t.labels.score}
            clickAttrs={site => gatewaySiteClickAttrs({ name: site.name, slug: site.slug, outboundUrl: '' })}
          />
          <p class="px-4 pt-3 text-sm leading-6 text-base-content/75">{t.llmGateway.rankingIndependenceNote}</p>
          <DataTable
            variant="gatewaySites"
            tbodyDataAttrs={{ 'data-gateway-home-sites-list': '' }}
            emptyText={t.llmGateway.filterEmpty}
            emptyDataAttrs={{ 'data-home-site-empty': '' }}
            loadingText={t.labels.loading}
            loadingDataAttrs={{ 'data-gateway-loading': 'sites' }}
            summaryText={t.labels.displaySummary}
            summaryRenderedCount={topSites.length}
            summaryDataAttrs={{ 'data-gateway-load-summary': 'sites' }}
            totalCount={gatewayData.totalSiteCount}
            loadMoreText={hasMoreSites ? t.labels.loadMore : ''}
            loadMoreHidden={!hasMoreSites}
            loadMoreDataAttrs={{ 'data-gateway-load-more': 'sites' }}
          >
            <Fragment slot="head">
              <DataTableHeader label={t.labels.sequence} sortKey="sequence" sortType="number" align="center" />
              <DataTableHeader label={t.llmGateway.basicInfo} sortKey="name" />
              <DataTableHeader label={t.labels.score} sortKey="score" sortType="number" align="right" helpTip={t.llmGateway.gatewayScoreTip} helpLabel={t.llmGateway.gatewayScoreHelpLabel} />
              <DataTableHeader label={t.llmGateway.supportedModels} sortKey="families" />
              <DataTableHeader label={t.labels.latestRefresh} sortKey="updatedAt" />
            </Fragment>
            {topSites.map((site, index) => {
              const families = uniqueLabels(site.displayModelFamilies, 8);
              const rank = index + 1;
              return (
                <GatewaySiteTableRow
                  site={site}
                  sequence={rank}
                  sequenceLabel={t.labels.sequence}
                  basicInfoLabel={t.llmGateway.basicInfo}
                  sponsorLabel={t.sponsors.sponsorLabel}
                  sponsorDescription={t.sponsors.sponsorDescription}
                  sponsorHref={linkTo('/partnership')}
                  sponsorLinkLabel={t.sponsors.partnershipLinkLabel}
                  detailLabel={t.llmGateway.viewDetail}
                  detailHref={linkTo(`/llm-gateway/${site.slug}`)}
                  clickAttrs={gatewaySiteClickAttrs(site)}
                  scoreLabel={t.labels.score}
                  referenceSampleLabel={t.shops.referenceSample}
                  sampledAtLabel={t.llmGateway.sampledAt}
                  sourceLabel={t.shops.sourcePrefix}
                  rowAttrs={{
                    'data-home-site-card': '',
                    'data-search': `${site.name} ${site.url} ${site.host} ${site.displayModelFamilies.join(' ')}`.toLowerCase(),
                    'data-families': families.map(item => item.toLowerCase()).join(','),
                    'data-original-order': String(index),
                    'data-sort-sequence': String(rank),
                    'data-sort-name': site.name,
                    'data-sort-score': String(site.siteScore || 0),
                    'data-sort-families': families.join(' '),
                    'data-sort-updated-at': site.latestGatewayRefreshTime,
                  }}
                >
                  <DataTableCell label={t.llmGateway.supportedModels}>
                    {families.length > 0 ? (
                      <div class="flex flex-wrap gap-1.5">
                        {families.map(family => <span class="badge badge-primary badge-outline badge-sm">{family}</span>)}
                      </div>
                    ) : (
                      <span class="text-base-content/35">-</span>
                    )}
                  </DataTableCell>
                  <DataTableCell label={t.labels.latestRefresh} class="whitespace-nowrap text-xs text-base-content/70">{site.latestGatewayRefreshTime || t.labels.notRecorded}</DataTableCell>
                </GatewaySiteTableRow>
              );
            })}
          </DataTable>
      </div>

      <div id="gatewayModelsPanel" class="flex w-full min-w-0 flex-col gap-0" role="tabpanel" aria-labelledby="gatewayModelsTab" data-gateway-panel="models" hidden>
          <div class="gateway-filter-grid grid gap-3 border-b border-base-300 p-4">
            <label class="input input-bordered flex h-11 items-center gap-2">
              <input data-home-model-search type="search" class="grow text-sm" placeholder={t.llmGateway.modelSearchPlaceholder} />
            </label>
          </div>
          <DataTable
            variant="gatewayModels"
            tbodyDataAttrs={{ 'data-gateway-home-models-list': '' }}
            emptyText={t.llmGateway.filterEmpty}
            emptyDataAttrs={{ 'data-home-model-empty': '' }}
            loadingText={t.labels.loading}
            loadingDataAttrs={{ 'data-gateway-loading': 'models' }}
            summaryText={t.labels.displaySummary}
            summaryRenderedCount={topModels.length}
            summaryDataAttrs={{ 'data-gateway-load-summary': 'models' }}
            totalCount={gatewayModelData.totalModelCount}
            loadMoreText={hasMoreModels ? t.labels.loadMore : ''}
            loadMoreHidden={!hasMoreModels}
            loadMoreDataAttrs={{ 'data-gateway-load-more': 'models' }}
          >
            <Fragment slot="head">
              <DataTableHeader label={t.labels.sequence} sortKey="sequence" sortType="number" align="center" />
              <DataTableHeader label={t.labels.model} sortKey="model" />
              <DataTableHeader label={t.llmGateway.modelFamily} sortKey="family" />
              <DataTableHeader label={t.llmGateway.supportedGatewayCount} sortKey="supportCount" sortType="number" align="right" />
            </Fragment>
            {topModels.map((model, index) => (
              <tr data-home-model-card data-search={`${model.modelId} ${model.modelFamily}`.toLowerCase()} data-original-order={String(index)} data-sort-sequence={String(index + 1)} data-sort-model={model.modelId} data-sort-family={model.modelFamily} data-sort-support-count={String(model.supportSiteCount || 0)}>
                <DataTableCell label={t.labels.sequence} align="center" sequence>{index + 1}</DataTableCell>
                <DataTableCell label={t.labels.model}>
                  <a href={modelHref(model.modelId)} class="link link-hover break-words font-mono text-sm font-semibold text-primary" {...gatewayModelClickAttrs(model)}>{model.modelId}</a>
                </DataTableCell>
                <DataTableCell label={t.llmGateway.modelFamily}>{model.modelFamily}</DataTableCell>
                <DataTableCell label={t.llmGateway.supportedGatewayCount} align="right" class="font-mono">{model.supportSiteCount}</DataTableCell>
              </tr>
            ))}
          </DataTable>
      </div>
    </section>
  )}
  <dialog id="gatewaySubmitDialog" class="modal">
    <div class="modal-box max-w-3xl p-0">
      <section class="card bg-base-100 shadow-none"><div class="card-body relative grid gap-5 p-5">
        <h2 class="page-hero-title mt-0">{t.llmGateway.submitGateway}</h2>
        <p class="text-sm leading-6 text-base-content">{t.llmGateway.submitDescription}</p>
        <p class="text-sm leading-6 text-base-content/80">{t.llmGateway.submitTypeDescription} <a href={`${linkTo('/shops')}?submit-dialog`} class="link link-primary font-medium" data-umami-event="gateway-submit-shop-link" data-umami-event-url={`${linkTo('/shops')}?submit-dialog`}>{t.llmGateway.submitShopLink}</a>{t.llmGateway.submitTypeSentenceEnd}</p>
        <form method="dialog" class="absolute right-5 top-5"><button type="submit" class="btn btn-ghost btn-circle btn-sm" aria-label={t.llmGateway.closeSubmitDialog}>✕</button></form>
        <div class="alert alert-info alert-soft flex flex-col items-start gap-1.5 text-left text-base-content">
          <span class="font-bold text-sm">{t.shops.cooperationTitle}</span>
          <p class="text-sm text-base-content leading-6">{t.shops.cooperationDescription}<a href={linkTo('/partnership')} target="_blank" rel="noopener noreferrer" data-umami-event="gateway-submit-partnership-click" data-umami-event-url={linkTo('/partnership')} data-umami-event-name={t.shops.cooperationDetails} class="link link-primary font-medium">{t.shops.cooperationDetails}</a>{t.shops.cooperationSentenceEnd}</p>
        </div>
        <section class="rounded-xl border border-base-300 bg-base-100 p-4" aria-label={t.llmGateway.emailSubmissionTitle}>
          <div class="flex items-start gap-3">
            <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-success/10 text-success" aria-hidden="true">✉</span>
            <div class="min-w-0">
              <h3 class="font-semibold">{t.llmGateway.emailSubmissionTitle}</h3>
              <p class="mt-1 text-sm leading-6 text-base-content/75">{t.llmGateway.emailSubmissionDescription}</p>
            </div>
          </div>
          <ul class="mt-3 grid gap-2 text-sm leading-6 text-base-content/80 sm:grid-cols-2">
            {gatewaySubmissionChecklist.map(item => <li class="flex gap-2"><span class="text-success">✓</span><span>{item}</span></li>)}
          </ul>
          <div class="mt-4 flex flex-wrap gap-2">
            <a href={gatewayMailto} class="btn btn-primary btn-sm">{t.llmGateway.emailSubmissionAction}：{gatewaySubmissionEmail}</a>
            <a href={telegramGroupUrl} target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-sm">{t.llmGateway.emailSubmissionTelegram}</a>
          </div>
        </section>
        <form id="gatewaySubmitForm" class="form-control grid gap-5" method="post" action="/api/gateway-submit">
          <div class="grid gap-1.5"><label for="gatewayNameInput" class="label p-0 font-semibold text-sm">{t.llmGateway.submitName}<span class="text-error" aria-hidden="true">*</span></label><p class="text-xs text-base-content">{t.llmGateway.submitNameDescription}</p><input id="gatewayNameInput" name="name" required maxlength="20" class="input input-bordered w-full" placeholder="Example API" /></div>
          <div class="grid gap-1.5"><label for="gatewaySummaryInput" class="label p-0 font-semibold text-sm">{t.llmGateway.submitSummary}</label><p class="text-xs text-base-content">{t.llmGateway.submitSummaryDescription}</p><textarea id="gatewaySummaryInput" name="summary" maxlength="150" rows="3" class="textarea textarea-bordered w-full" placeholder={t.llmGateway.submitSummaryPlaceholder}></textarea></div>
          <div class="grid gap-1.5"><label for="gatewayUrlInput" class="label p-0 font-semibold text-sm">{t.llmGateway.submitUrl}<span class="text-error" aria-hidden="true">*</span></label><p class="text-xs text-base-content">{t.llmGateway.submitUrlDescription}</p><input id="gatewayUrlInput" name="url" type="url" required class="input input-bordered w-full" placeholder="https://www.example.com" autocomplete="url" /></div>
          <div class="grid gap-1.5"><label for="gatewayApiEndpointInput" class="label p-0 font-semibold text-sm">{t.llmGateway.submitApiEndpoint}</label><p class="text-xs text-base-content">{t.llmGateway.submitApiEndpointDescription}</p><input id="gatewayApiEndpointInput" name="apiEndpoint" type="url" class="input input-bordered w-full" placeholder="https://api.example.com" autocomplete="url" /></div>
          <div class="grid gap-1.5"><label class="label p-0 font-semibold text-sm" for="gatewayPaymentSelect">{t.llmGateway.paymentMethods}</label><p class="text-xs text-base-content">{t.llmGateway.submitPaymentDescription}</p><details id="gatewayPaymentSelect" class="dropdown dropdown-top w-full"><summary class="select select-bordered flex h-auto min-h-12 w-full cursor-pointer list-none items-center gap-2 px-3 py-2"><span data-payment-selection-label class="text-base-content">{t.llmGateway.selectPaymentMethods}</span></summary><div class="dropdown-content z-50 mb-2 max-h-64 w-full overflow-y-auto rounded-box border border-base-300 bg-base-100 p-2 shadow-lg"><div class="grid gap-1 sm:grid-cols-2">{Object.entries(t.llmGateway.paymentMethodLabels).map(([key, label]) => <button type="button" class="gateway-payment-option flex min-h-10 items-center justify-between rounded-md px-3 py-2 text-left text-sm hover:bg-base-200 disabled:cursor-not-allowed disabled:bg-base-200 disabled:text-base-content/65 disabled:opacity-100" data-payment-key={key} data-payment-label={label} aria-pressed="false"><span>{label}</span><span class="gateway-payment-check hidden text-primary" aria-hidden="true">✓</span></button>)}</div></div></details></div>
          <p id="gatewaySubmitError" class="hidden text-sm text-error font-medium"></p><p id="gatewaySubmitSuccess" class="hidden text-sm text-primary font-medium"></p>
          <div class="card-actions justify-start mt-2"><button type="submit" class="btn btn-primary" data-umami-event="gateway-submit-click">{t.actions.submit}</button></div>
        </form>
      </div></section>
    </div>
    <form method="dialog" class="modal-backdrop"><button type="submit" aria-label={t.llmGateway.closeSubmitBackdrop}>{t.llmGateway.closeSubmitDialog}</button></form>
  </dialog>
  <script is:inline slot="scripts" type="application/json" id="gateway-home-config" set:html={JSON.stringify(gatewayHomeConfig)}></script>
  <script is:inline slot="scripts" type="application/json" id="gateway-submit-messages" set:html={JSON.stringify({ locale: Astro.locals.locale, submit: t.submit, gateway: { selectPaymentMethods: t.llmGateway.selectPaymentMethods, paymentMethodSeparator: t.llmGateway.paymentMethodSeparator } })}></script>
  <script is:inline slot="scripts" src={sponsorBadgeScriptUrl}></script>
  <script is:inline slot="scripts" defer src={dataTableScriptUrl}></script>
  <script is:inline slot="scripts" defer src={pageWidgetsScriptUrl}></script>
  <script>
    import '../scripts/llm-gateway-home.js';
  </script>
</PublicPage>
